# University LMS - Smart Learning Ecosystem Configuration
# Copy this file to .env and fill in your custom values

# Application Security
SECRET_KEY=lms-university-secret-key-2026-secure
MAX_UPLOAD_SIZE_MB=16

# AI Gateway Configuration
AI_API_ENABLED=0
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_DAILY_TOKEN_LIMIT=50000

# Feature Flags (1 = Enabled, 0 = Disabled)
FEATURE_ANALYTICS_ENABLED=1
FEATURE_ADAPTIVE_ENABLED=1
FEATURE_SMART_ASSESSMENT_ENABLED=1

# Log Retention
LOG_RETENTION_DAYS=90
